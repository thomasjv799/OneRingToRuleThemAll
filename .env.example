# Master Bot — OneRingToRuleThemAll
# Copy to .env and fill in values

# OpenRouter (LLM)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=moonshotai/kimi-k2.6:free                 # primary (free)
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat-v3-0324   # paid fallback when free tier is rate-limited (cheap, good tool-calling)

# Database — local homelab Postgres
DATABASE_URI=postgresql://homelab:choolackal@localhost:5432/homelab

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optional)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
