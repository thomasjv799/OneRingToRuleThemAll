# Master Bot — OneRingToRuleThemAll
# Copy to .env and fill in values

# OpenRouter (LLM) — https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324
# OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat-v3-0324  # optional fallback model

# Database — local homelab Postgres
DATABASE_URI=postgresql://homelab:choolackal@localhost:5432/homelab

# IsThereAnyDeal (game prices) — https://isthereanydeal.com/dev/app/
ITAD_API_KEY=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optional)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Cron alert routing (proactive deal alerts + vehicle reminders)
CRON_NOTIFY_PLATFORM=telegram        # telegram | discord
CRON_NOTIFY_CHAT_ID=                 # defaults to TELEGRAM_CHAT_ID if blank

# Langfuse (LLM observability) — get keys from cloud.langfuse.com
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com
