# Master Bot — OneRingToRuleThemAll
# Copy to .env and fill in values

# OpenRouter (LLM)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324           # paid, cheap, reliable tool-calling
# OPENROUTER_MODEL=moonshotai/kimi-k2.6:free              # free tier alternative (often rate-limited)
# OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat-v3-0324  # optional fallback if primary is a free model

# Database — local homelab Postgres
DATABASE_URI=postgresql://homelab:choolackal@localhost:5432/homelab

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord (optional)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Langfuse (LLM observability) — get keys from cloud.langfuse.com
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com
